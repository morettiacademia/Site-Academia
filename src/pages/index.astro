---
import { Picture, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ImgSlot from '../components/ImgSlot.astro';
import Star from '../components/Star.astro';
import Pending from '../components/Pending.astro';
import BlogCard from '../components/BlogCard.astro';
import heroSocios from '../assets/hero-socios.png';
import Socios from '../components/Socios.astro';
import { SHOW_PENDING } from '../lib/pending';
import { links } from '../lib/site';
import { recentPosts } from '../lib/blog';
import { destaque, diasPara } from '../data/destaque';

// Slide 1 tem foto; os demais aguardam fotos reais (seção 11 do handoff).
const slideDefs = [
  { src: heroSocios, alt: 'Camila Moretti, Joice Ferreira e Paulo Soares, sócios da Academia da Magia' },
  { src: null, alt: 'Alunos da Academia em Orlando' },
  { src: null, alt: 'Magic Makers ao Vivo — plateia' },
  { src: null, alt: 'Imersão a bordo / Magic Makers Experience' },
  { src: null, alt: 'Turma em aula ou mentoria' },
];
const fotos = slideDefs.filter((s) => s.src || SHOW_PENDING);
// Com um evento em destaque, ele abre o carrossel.
const total = fotos.length + (destaque.ativo ? 1 : 0);
const dias = diasPara(destaque.inicio);

// Pré-carrega o LCP (slide 1)
const lcp = await getImage({ src: heroSocios, width: 1600, format: 'avif', quality: 70 });

const portals = [
  { label: 'Especializações', short: 'especializações', text: 'Desenvolva uma competência que fortaleça sua entrega.', bg: '#1b5aa8', ph: 'aula / especialização' },
  { label: 'Destinos', short: 'destinos', text: 'Conhecimento de produto para vender com segurança.', bg: '#2a6bb8', ph: 'destino' },
  { label: 'Comunidade', short: 'comunidade', text: 'Eventos, imersões e aula semanal com quem vive o turismo.', bg: '#36b6e9', ph: 'Magic Makers ao Vivo' },
  { label: 'Mentorias', short: 'mentorias', text: 'Comece, estruture e faça crescer a sua agência com acompanhamento.', bg: '#1f3566', ph: 'mentoria' },
];

const quizOptions = ['Quero começar no turismo', 'Sou agente em início de carreira', 'Quero me especializar', 'Tenho uma agência e quero crescer'];
const posts = await recentPosts(3);
---
<Base
  title="Academia da Magia — Formação para profissionais do turismo"
  description="Cursos, mentorias, comunidade e experiências para profissionais do turismo. Descubra seu próximo passo."
>
  <link slot="head" rel="preload" as="image" href={lcp.src} type="image/avif" fetchpriority="high" />

  <!-- 1. Hero em carrossel -->
  <section class="hero" aria-roledescription="carrossel" aria-label="Destaques" data-carousel>
    <h1 class="sr-only">Academia da Magia: cursos, mentorias, comunidade e experiências para profissionais do turismo</h1>
    <div class="slides">
      {destaque.ativo && (
        <div class="slide active" data-slide aria-roledescription="slide" aria-label={`1 de ${total}: ${destaque.nome} ${destaque.ano}`}>
          <div class="media media-evento" aria-hidden="true">
            <div class="ticket">
              <div class="ticket-stub"><span>{destaque.edicao}</span></div>
              <div class="ticket-main">
                <span class="t-kicker"><Star size="12" /> Ingresso</span>
                <span class="t-name">{destaque.nome}</span>
                <span class="t-date">{destaque.quandoCurto}</span>
                <span class="t-place">{destaque.onde}</span>
              </div>
            </div>
            <div class="scrim scrim-evento"></div>
          </div>
          <div class="text-wrap">
            <div class="container text-inner">
              <div class="col">
                <div class="eyebrow ev-eyebrow"><span class="live"><span class="pulse"></span>{destaque.selo}</span><span>{destaque.edicao} · {destaque.quando}</span></div>
                <h2 class="h1-home">{destaque.nome} <span class="hl">{destaque.ano}</span></h2>
                <p class="lead hero-lead">{destaque.chamada} {destaque.onde.split(' · ').pop()}, {destaque.vagas}.</p>
                <div class="count" data-contador={destaque.inicio}><span class="count-n" data-dias>{dias}</span><span class="count-l">dias para o evento</span></div>
                <div class="btn-row">
                  <a href={destaque.url} target="_blank" rel="noopener" class="btn btn-cyan" data-track="cta_inscricao_click" data-track-slug={destaque.slug} data-track-origem="home_hero">{destaque.cta} →</a>
                  <a href={`/${destaque.slug}`} class="btn btn-outline">Conheça o evento</a>
                </div>
              </div>
            </div>
          </div>
        </div>
      )}
      {fotos.map((f, k) => {
        const i = k + (destaque.ativo ? 1 : 0);
        return (
          <div class:list={['slide', { active: i === 0 }]} data-slide aria-roledescription="slide" aria-label={`${i + 1} de ${total}`} aria-hidden={i === 0 ? undefined : 'true'}>
            <div class="media">
              {f.src ? (
                <Picture src={f.src} alt={f.alt} formats={['avif']} fallbackFormat="webp" widths={[640, 960, 1280, 1600, 2000].filter((w) => w <= f.src!.width)} sizes="100vw" quality={70} loading="eager" fetchpriority={k === 0 ? 'high' : 'auto'} />
              ) : (
                <ImgSlot label={f.alt} style="width:100%;height:100%;background:#1b5aa8" />
              )}
              <div class="scrim" aria-hidden="true"></div>
            </div>
            <div class="text-wrap">
              <div class="container text-inner">
                <div class="col">
                  <div class="eyebrow hero-eyebrow"><span class="stars" aria-hidden="true"><Star size="13" /><Star size="13" /><Star size="13" /></span>Formação · Estratégia · Experiências</div>
                  <h2 class="h1-home">Sua paixão por viagens vira <span class="hl">autoridade</span> e negócio.</h2>
                  <p class="lead hero-lead">Cursos, mentorias, comunidade e experiências para quem está começando no turismo — e para quem quer crescer com mais direção.</p>
                  <div class="btn-row">
                    <a href="/comece-aqui" class="btn btn-cyan" data-track="cta_comece_aqui" data-track-origem="home_hero">Descubra seu próximo passo →</a>
                    <a href="#caminhos" class="btn btn-outline">Explore as formações</a>
                  </div>
                </div>
              </div>
            </div>
          </div>
        );
      })}
    </div>
    {total > 1 && (
      <div class="controls-wrap">
        <div class="container">
          <div class="controls">
            {Array.from({ length: total }, (_, i) => (
              <button type="button" class:list={['dot', { on: i === 0 }]} aria-label={`Destaque ${i + 1}`} aria-current={i === 0 ? 'true' : 'false'} data-dot={i}></button>
            ))}
            <button type="button" class="play" aria-label="Pausar carrossel" data-play>❚❚</button>
          </div>
        </div>
      </div>
    )}
  </section>

  <!-- 1b. Evento em destaque -->
  {destaque.ativo && (
    <section class="bg-blue evento" aria-labelledby="evento-t">
      <div class="container evento-inner">
        <div class="stack" style="gap:14px">
          <span class="eyebrow ev-kicker"><Star size="12" /> {destaque.selo} · {destaque.edicao}</span>
          <h2 class="h2" id="evento-t">{destaque.nome} <span class="hl">{destaque.ano}</span></h2>
          <p class="evento-p">{destaque.texto}</p>
        </div>
        <dl class="evento-facts">
          <div><dt>Quando</dt><dd>{destaque.quando}</dd></div>
          <div><dt>Onde</dt><dd>{destaque.onde}</dd></div>
          <div><dt>Vagas</dt><dd>{destaque.vagas}</dd></div>
          <div data-contador={destaque.inicio}><dt>Faltam</dt><dd><span data-dias>{dias}</span> dias</dd></div>
        </dl>
        <div class="evento-ctas">
          <a href={destaque.url} target="_blank" rel="noopener" class="btn btn-white" data-track="cta_inscricao_click" data-track-slug={destaque.slug} data-track-origem="home_secao_evento">{destaque.cta} →</a>
          <a href={`/${destaque.slug}`} class="evento-more">Ver a programação e os ingressos</a>
        </div>
      </div>
    </section>
  )}

  <!-- 2. Caminhos -->
  <section id="caminhos" class="bg-navy">
    <div class="container stack caminhos">
      <div class="head-row">
        <h2 class="h2-caminhos">Existe um próximo passo para o <span class="hl-cyan">seu momento.</span></h2>
        <p class="muted side-text">A jornada não é igual para todo mundo. Escolha por onde seguir.</p>
      </div>
      <div class="grid-auto" style="--min:290px">
        {portals.map((p, i) => (
          <a href="/comece-aqui" class="portal" style={`background:${p.bg}`} data-track="cta_comece_aqui" data-track-origem={`portal_${p.short}`}>
            <ImgSlot label={p.ph} class="portal-img" style={`background:${p.bg}`} />
            <div class="portal-scrim" aria-hidden="true"></div>
            <div class="portal-body">
              <span class="portal-num">0{i + 1}</span>
              <span class="portal-title">{p.label}</span>
              <span class="portal-text">{p.text}</span>
              <span class="portal-pill">Ver {p.short} →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 3. Manifesto -->
  <section class="bg-cyan">
    <div class="container section-lg stack manifesto">
      <h2 class="h-manifesto">Conhecimento que sai da aula e entra no seu trabalho.</h2>
      <div class="head-row">
        <p class="manifesto-text">Formação, prática e comunidade juntas: entender o cliente, dominar destinos, organizar o negócio e construir relações no mercado.</p>
        <a href="/sobre" class="btn btn-navy btn-pill btn-navy-on-cyan">Conheça a Academia →</a>
      </div>
    </div>
  </section>

  <!-- 4. Sócios -->
  <Socios id="sobre" />

  <!-- 5. Chamada do quiz -->
  <section id="quiz" class="bg-blue">
    <div class="container quiz">
      <div class="stack" style="gap:22px">
        <h2 class="h2-quiz">Qual formação faz sentido <span class="hl">agora?</span></h2>
        <p class="quiz-text">Perguntas rápidas. Uma recomendação explicada. Sem pedir contato antes do resultado.</p>
      </div>
      <div class="quiz-card">
        <div class="quiz-meta"><span>1 de 6</span><span>Seu momento</span></div>
        <div class="quiz-bar"><div></div></div>
        <p class="quiz-q" id="quiz-q">Como você descreve sua situação hoje?</p>
        <div role="radiogroup" aria-labelledby="quiz-q" class="quiz-opts" data-quiz>
          {quizOptions.map((o) => (
            <button type="button" role="radio" aria-checked="false" class="quiz-opt">{o}</button>
          ))}
        </div>
        <a href="/comece-aqui" class="btn btn-navy btn-pill btn-sm quiz-go" data-track="cta_comece_aqui" data-track-origem="home_quiz">Descobrir meu próximo passo →</a>
      </div>
    </div>
  </section>

  <!-- 6. Protagonistas -->
  <section id="protagonistas" class="bg-navy">
    <div class="container quiz">
      <ImgSlot label="Protagonistas" class="protag-img" />
      <div class="stack" style="gap:22px">
        <span class="eyebrow hl-cyan">Protagonistas</span>
        <h2 class="h2">Aprender abre caminhos para participar ainda mais.</h2>
        <p class="muted protag-text">Pessoas que crescem com a Academia e passam a compartilhar conhecimento, representar destinos e movimentar a comunidade.</p>
        {links.protagonistas ? (
          <a href={links.protagonistas} target="_blank" rel="noopener" class="btn btn-outline-cyan btn-pill btn-sm" style="align-self:flex-start" data-track="protagonistas_outbound">Conhecer o Protagonistas ↗</a>
        ) : (
          <Pending tag="URL do site oficial do Protagonistas" prefix="Pendente:" />
        )}
      </div>
    </div>
  </section>

  <!-- 7. Do blog -->
  {posts.length > 0 && (
    <section id="blog" class="bg-light">
      <div class="container section stack" style="gap:36px">
        <div class="head-row">
          <h2 class="h2-sm">Do blog</h2>
          <a href="/blog" class="more-link">Ver todos os artigos →</a>
        </div>
        <div class="grid-auto" style="--min:300px;gap:24px">
          {posts.map((p) => <BlogCard post={p} />)}
        </div>
      </div>
    </section>
  )}
</Base>

<style>
  /* Hero: cada slide tem foto e texto; os slides dividem a mesma célula do grid */
  .hero { position: relative; background: var(--navy-800); }
  .slides { display: grid; }
  .slide { grid-area: 1 / 1; display: flex; flex-direction: column; opacity: 0; visibility: hidden; transition: opacity 1.2s ease, visibility 0s linear 1.2s; }
  .slide.active { opacity: 1; visibility: visible; transition: opacity 1.2s ease; }
  .media { position: relative; height: clamp(280px, 58vw, 620px); overflow: hidden; background: var(--blue-600); }
  .media :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: 70% center; }
  .media :global(picture) { display: block; width: 100%; height: 100%; }
  .scrim { position: absolute; inset: 0; pointer-events: none; background: linear-gradient(0deg, #0c1b3d 0%, rgba(12, 27, 61, 0) 35%); }
  .text-wrap { position: relative; }
  .text-inner { padding-top: 8px; padding-bottom: 104px; display: flex; flex-direction: column; justify-content: flex-end; height: 100%; }
  .col { display: flex; flex-direction: column; gap: 24px; }
  .hero-eyebrow { display: flex; align-items: center; gap: 12px; color: var(--cyan-200); }
  .stars { display: inline-flex; gap: 4px; color: var(--white); }
  .hero-lead { color: var(--ink-on-blue); max-width: 540px; }
  .btn-row { display: flex; gap: 12px; flex-wrap: wrap; }

  /* Slide do evento */
  .media-evento {
    display: flex; align-items: center; justify-content: center;
    background:
      radial-gradient(1.5px 1.5px at 12% 22%, #fff 50%, transparent 51%),
      radial-gradient(1px 1px at 28% 68%, #cfe6f7 50%, transparent 51%),
      radial-gradient(2px 2px at 46% 14%, #fff 50%, transparent 51%),
      radial-gradient(1px 1px at 63% 42%, #cfe6f7 50%, transparent 51%),
      radial-gradient(1.5px 1.5px at 78% 80%, #fff 50%, transparent 51%),
      radial-gradient(1px 1px at 88% 26%, #fff 50%, transparent 51%),
      radial-gradient(1.5px 1.5px at 94% 58%, #cfe6f7 50%, transparent 51%),
      radial-gradient(ellipse at 72% 45%, #2f72c4 0%, #1b5aa8 35%, #0c1b3d 80%);
  }
  .ticket { position: relative; z-index: 1; display: flex; width: min(86%, 560px); transform: rotate(-4deg); filter: drop-shadow(0 30px 60px rgba(4, 12, 32, .5)); }
  .ticket-stub { background: var(--cyan-500); color: var(--navy-800); border-radius: 20px 0 0 20px; padding: 18px 12px; display: flex; align-items: center; justify-content: center; border-right: 3px dashed var(--navy-800); }
  .ticket-stub span { writing-mode: vertical-rl; transform: rotate(180deg); font-weight: 800; font-size: 13px; letter-spacing: .14em; text-transform: uppercase; }
  .ticket-main { flex: 1; background: var(--white); color: var(--navy-800); border-radius: 0 20px 20px 0; padding: clamp(18px, 3vw, 32px); display: flex; flex-direction: column; gap: 6px; }
  .t-kicker { display: inline-flex; align-items: center; gap: 6px; font-size: 12px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: var(--blue-600); }
  .t-name { font-family: var(--font-display); font-weight: 800; font-size: clamp(24px, 3.4vw, 44px); line-height: .95; letter-spacing: -0.03em; }
  .t-date { font-family: var(--font-display); font-weight: 800; font-size: clamp(30px, 4.6vw, 60px); line-height: 1; letter-spacing: -0.03em; color: var(--blue-600); }
  .t-place { font-size: clamp(12px, 1.2vw, 15px); font-weight: 600; color: var(--ink-muted); }
  .scrim-evento { background: linear-gradient(0deg, #0c1b3d 0%, rgba(12, 27, 61, 0) 30%); }
  .ev-eyebrow { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 14px; color: var(--cyan-200); }
  .live { display: inline-flex; align-items: center; gap: 8px; background: var(--cyan-500); color: var(--navy-800); padding: 6px 12px; border-radius: 999px; letter-spacing: .1em; }
  .pulse { width: 8px; height: 8px; border-radius: 50%; background: var(--navy-800); animation: pulse 1.6s ease-in-out infinite; }
  @keyframes pulse { 50% { opacity: .25; } }
  .count { align-self: flex-start; display: flex; align-items: baseline; gap: 10px; border: 1.5px solid var(--cyan-300); border-radius: 14px; padding: 10px 16px; }
  .count-n { font-family: var(--font-display); font-size: 34px; font-weight: 800; line-height: 1; }
  .count-l { font-size: 14px; font-weight: 600; color: var(--ink-on-blue); }

  /* Controles */
  .controls-wrap { position: absolute; left: 0; right: 0; bottom: 28px; z-index: 2; pointer-events: none; }
  .controls { display: flex; align-items: center; gap: 10px; pointer-events: auto; width: max-content; }
  .dot { all: unset; cursor: pointer; width: 8px; height: 8px; border-radius: 8px; background: rgba(255, 255, 255, 0.45); transition: width .3s; position: relative; }
  .dot::after { content: ''; position: absolute; inset: -18px -4px; } /* alvo de toque ≥ 44px */
  .dot.on { width: 28px; background: var(--white); }
  .dot:focus-visible { outline: 3px solid var(--cyan-500); outline-offset: 3px; }
  .play { margin-left: 6px; width: 44px; height: 44px; border-radius: 50%; border: 1.5px solid rgba(255, 255, 255, 0.6); background: transparent; color: var(--white); font-size: 13px; cursor: pointer; }

  @media (min-width: 1200px) {
    /* Foto e texto na mesma célula: a altura é a maior entre os dois,
       então o título nunca sobe por baixo do cabeçalho em janelas baixas. */
    .slide { display: grid; }
    .media { grid-area: 1 / 1; height: auto; min-height: clamp(600px, 88vh, 920px); }
    .scrim {
      background:
        linear-gradient(90deg, rgba(12, 27, 61, .95) 0%, rgba(12, 27, 61, .75) 30%, rgba(12, 27, 61, 0) 52%),
        linear-gradient(0deg, rgba(12, 27, 61, .6) 0%, rgba(12, 27, 61, 0) 30%);
    }
    .scrim-evento { background: linear-gradient(90deg, rgba(12, 27, 61, .9) 0%, rgba(12, 27, 61, .5) 34%, rgba(12, 27, 61, 0) 50%); }
    .media-evento { justify-content: flex-end; padding-right: max(24px, calc((100vw - 1320px) / 2 + 24px)); }
    .ticket { width: min(46%, 600px); }
    .text-wrap { grid-area: 1 / 1; z-index: 1; pointer-events: none; }
    .text-inner { padding-top: clamp(40px, 6vw, 88px); padding-bottom: calc(clamp(40px, 6vw, 88px) + 56px); }
    .col { max-width: 40%; }
    .btn-row { pointer-events: auto; }
    .controls-wrap { bottom: clamp(32px, 4vw, 60px); }
  }

  /* Seção do evento */
  .evento-inner { padding-block: clamp(48px, 6vw, 88px); display: grid; gap: 32px 56px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr)); align-items: center; }
  .ev-kicker { display: inline-flex; align-items: center; gap: 8px; color: var(--cyan-200); }
  .evento-p { font-size: 17px; line-height: 1.55; color: var(--ink-on-blue); max-width: 560px; }
  .evento-facts { margin: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1px; background: var(--blue-line); border: 1px solid var(--blue-line); border-radius: 24px; overflow: hidden; }
  .evento-facts > div { background: var(--blue-600); padding: 20px 22px; display: flex; flex-direction: column; gap: 6px; }
  .evento-facts dt { font-size: 12px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--cyan-200); }
  .evento-facts dd { margin: 0; font-size: 17px; font-weight: 700; line-height: 1.35; }
  .evento-ctas { grid-column: 1 / -1; display: flex; flex-wrap: wrap; gap: 16px 24px; align-items: center; }
  .evento-more { font-weight: 700; color: var(--white); text-decoration: underline; text-underline-offset: 4px; }
  .evento-more:hover { color: var(--cyan-300); }

  /* Caminhos */
  .caminhos { padding-block: clamp(64px, 8vw, 120px); gap: 48px; }
  .h2-caminhos { font-family: var(--font-display); font-weight: 800; font-size: clamp(38px, 5vw, 72px); line-height: .98; letter-spacing: -0.03em; max-width: 780px; }
  .side-text { font-size: 17px; line-height: 1.55; max-width: 400px; }
  .portal { position: relative; display: block; height: clamp(380px, 34vw, 480px); border-radius: 28px; overflow: hidden; color: var(--white); }
  .portal :global(.portal-img) { position: absolute; inset: 0; width: 100%; height: 100%; }
  .portal-scrim { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(12, 27, 61, 0) 30%, rgba(12, 27, 61, 0.88) 100%); }
  .portal-body { position: absolute; left: 0; right: 0; bottom: 0; padding: 28px; display: flex; flex-direction: column; gap: 10px; }
  .portal-num { font-size: 13px; font-weight: 700; letter-spacing: 0.12em; color: var(--cyan-300); }
  .portal-title { font-family: var(--font-display); font-size: clamp(28px, 2.6vw, 38px); font-weight: 800; line-height: 1; letter-spacing: -0.02em; }
  .portal-text { font-size: 15px; line-height: 1.45; color: var(--ink-on-navy); }
  .portal-pill { align-self: flex-start; margin-top: 8px; background: var(--white); color: var(--navy-800); font-weight: 700; font-size: 14px; padding: 10px 18px; border-radius: 999px; transition: background-color .2s, color .2s; }
  .portal:hover .portal-pill { background: var(--cyan-500); }

  /* Manifesto */
  .manifesto { gap: 36px; }
  .h-manifesto { font-family: var(--font-display); font-weight: 800; font-size: clamp(40px, 6.6vw, 104px); line-height: .94; letter-spacing: -0.035em; }
  .manifesto-text { font-size: 18px; line-height: 1.55; font-weight: 500; max-width: 560px; }

  /* Quiz / Protagonistas */
  .quiz { padding-block: clamp(64px, 8vw, 120px); display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 440px), 1fr)); gap: 48px; align-items: center; }
  .h2-quiz { font-family: var(--font-display); font-weight: 800; font-size: clamp(38px, 5vw, 72px); line-height: .96; letter-spacing: -0.03em; }
  .quiz-text { font-size: 18px; line-height: 1.55; color: var(--ink-on-blue); max-width: 480px; }
  .quiz-card { background: var(--white); color: var(--navy-800); border-radius: 28px; padding: clamp(24px, 3vw, 36px); display: flex; flex-direction: column; gap: 18px; box-shadow: 0 30px 80px rgba(4, 12, 32, 0.35); }
  .quiz-meta { display: flex; justify-content: space-between; font-size: 13px; font-weight: 700; color: var(--ink-muted); }
  .quiz-bar { height: 6px; background: #e8f2fb; border-radius: 6px; }
  .quiz-bar div { width: 16%; height: 100%; background: var(--cyan-500); border-radius: 6px; }
  .quiz-q { font-family: var(--font-display); font-size: 24px; font-weight: 700; line-height: 1.15; }
  .quiz-opts { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr)); gap: 10px; }
  .quiz-opt { text-align: left; border: 2px solid var(--line-light-2); background: var(--white); color: var(--navy-800); font-size: 15px; font-weight: 600; padding: 16px; border-radius: 16px; cursor: pointer; min-height: 64px; transition: border-color .2s, background-color .2s; }
  .quiz-opt:hover { border-color: var(--cyan-300); }
  .quiz-opt[aria-checked='true'] { border-color: var(--cyan-500); background: #e8f2fb; }
  .quiz-go { align-self: flex-start; padding: 16px 26px; }
  :global(.protag-img) { aspect-ratio: 4 / 3; border-radius: 28px; }
  .protag-text { font-size: 17px; line-height: 1.6; max-width: 520px; }

  .more-link { color: var(--blue-600); font-weight: 700; font-size: 15px; }
  .more-link:hover { color: var(--navy-800); }
</style>

<script>
  // Carrossel do hero: crossfade de 1.2s, troca a cada 5.5s, pausado com prefers-reduced-motion.
  const root = document.querySelector<HTMLElement>('[data-carousel]');
  const slides = root ? [...root.querySelectorAll<HTMLElement>('[data-slide]')] : [];
  if (root && slides.length > 1) {
    const dots = [...root.querySelectorAll<HTMLButtonElement>('[data-dot]')];
    const play = root.querySelector<HTMLButtonElement>('[data-play]')!;
    let current = 0;
    let playing = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const go = (i: number) => {
      current = (i + slides.length) % slides.length;
      slides.forEach((s, k) => {
        const on = k === current;
        s.classList.toggle('active', on);
        if (on) s.removeAttribute('aria-hidden'); else s.setAttribute('aria-hidden', 'true');
      });
      dots.forEach((d, k) => { d.classList.toggle('on', k === current); d.setAttribute('aria-current', String(k === current)); });
    };
    const renderPlay = () => {
      play.textContent = playing ? '❚❚' : '▶';
      play.setAttribute('aria-label', playing ? 'Pausar carrossel' : 'Reproduzir carrossel');
    };
    renderPlay();
    dots.forEach((d) => d.addEventListener('click', () => go(Number(d.dataset.dot))));
    play.addEventListener('click', () => { playing = !playing; renderPlay(); });
    // Pausa enquanto o visitante interage com o slide (mouse ou teclado).
    let hold = false;
    root.addEventListener('mouseenter', () => (hold = true));
    root.addEventListener('mouseleave', () => (hold = false));
    root.addEventListener('focusin', () => (hold = true));
    root.addEventListener('focusout', () => (hold = false));
    setInterval(() => { if (playing && !hold && !document.hidden) go(current + 1); }, 5500);
  }

  // Contadores de dias para o evento em destaque
  document.querySelectorAll<HTMLElement>('[data-contador]').forEach((el) => {
    const n = Math.max(0, Math.ceil((new Date(el.dataset.contador!).getTime() - Date.now()) / 86400000));
    el.querySelectorAll('[data-dias]').forEach((d) => (d.textContent = String(n)));
  });

  // Prévia do quiz: seleção ilustrativa (o quiz completo fica em /comece-aqui)
  document.querySelectorAll<HTMLElement>('[data-quiz]').forEach((g) => {
    const opts = [...g.querySelectorAll<HTMLButtonElement>('[role="radio"]')];
    opts.forEach((o) => o.addEventListener('click', () => opts.forEach((x) => x.setAttribute('aria-checked', String(x === o)))));
  });
</script>
