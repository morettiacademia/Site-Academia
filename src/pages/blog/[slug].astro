---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { allPosts, formatDate, type Post } from '../../lib/blog';

export async function getStaticPaths() {
  const posts = await allPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props as { post: Post };
const { Content } = await render(post);
const d = post.data;
const url = new URL(`/blog/${post.id}`, Astro.site).href;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: d.title,
    description: d.description,
    datePublished: d.pubDate.toISOString(),
    ...(d.updatedDate ? { dateModified: d.updatedDate.toISOString() } : {}),
    author: { '@type': d.author === 'Academia da Magia' ? 'Organization' : 'Person', name: d.author },
    publisher: { '@type': 'Organization', name: 'Academia da Magia' },
    mainEntityOfPage: url,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Início', item: new URL('/', Astro.site).href },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: new URL('/blog', Astro.site).href },
      { '@type': 'ListItem', position: 3, name: d.title, item: url },
    ],
  },
];
---
<Base title={`${d.title} | Academia da Magia`} description={d.description} ogType="article" jsonLd={jsonLd} noindex={d.draft}>
  <article>
    <header class="bg-blue">
      <div class="container head stack">
        <nav aria-label="Você está em" class="crumbs"><a href="/">Início</a> <span aria-hidden="true">›</span> <a href="/blog">Blog</a></nav>
        <span class="badge">{d.category}</span>
        {d.draft && <span class="pending">Rascunho — não publicado</span>}
        <h1 class="h1-prog">{d.title}</h1>
        <p class="meta">{d.author} · <time datetime={d.pubDate.toISOString()}>{formatDate(d.pubDate)}</time></p>
      </div>
    </header>
    <div class="bg-white">
      <div class="container section stack body">
        {d.cover && <Image src={d.cover} alt={d.coverAlt ?? ''} widths={[640, 960, 1280]} sizes="(min-width: 900px) 860px, 100vw" class="cover" loading="eager" />}
        <div class="prose"><Content /></div>
        <aside class="next">
          <p class="next-t">Qual formação faz sentido para você agora?</p>
          <a href="/comece-aqui" class="btn btn-blue" data-track="cta_comece_aqui" data-track-origem="blog">Descubra seu próximo passo →</a>
        </aside>
      </div>
    </div>
  </article>
</Base>
<style>
  .head { padding-block: clamp(48px, 7vw, 100px); gap: 20px; align-items: flex-start; }
  .h1-prog { max-width: 960px; }
  .crumbs { font-size: 13px; font-weight: 600; color: var(--cyan-200); display: flex; gap: 8px; }
  .crumbs a:hover { color: var(--white); }
  .meta { font-size: 15px; color: var(--ink-on-blue); }
  .body { gap: 40px; }
  .cover { width: 100%; max-width: 860px; border-radius: 24px; }
  .next { max-width: 720px; border-top: 1.5px solid var(--line-light); padding-top: 32px; display: flex; flex-direction: column; gap: 16px; align-items: flex-start; }
  .next-t { font-family: var(--font-display); font-weight: 800; font-size: 28px; line-height: 1.1; color: var(--navy-800); }
</style>
