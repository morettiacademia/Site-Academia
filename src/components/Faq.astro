---
/** Acordeão de perguntas frequentes: um item aberto por vez, o primeiro aberto por padrão. */
import Pending from './Pending.astro';
import type { Pv } from '../lib/pending';
interface Props { items: { q: string; a: Pv }[]; id: string }
const { items, id } = Astro.props;
---
<div class="faq" data-faq>
  {items.map((it, i) => (
    <div class="row">
      <h3 class="q">
        <button type="button" aria-expanded={i === 0 ? 'true' : 'false'} aria-controls={`${id}-${i}`} id={`${id}-${i}-btn`}>
          <span>{it.q}</span><span class="icon" aria-hidden="true">{i === 0 ? '−' : '+'}</span>
        </button>
      </h3>
      <div class="a" id={`${id}-${i}`} role="region" aria-labelledby={`${id}-${i}-btn`} hidden={i !== 0}>
        {it.a.text && <p>{it.a.text}</p>}
        <Pending tag={it.a.pending ? it.a.tag : null} />
      </div>
    </div>
  ))}
</div>

<style>
  .faq { display: flex; flex-direction: column; }
  .row { border-top: 1.5px solid var(--line-light); }
  .q { font: inherit; }
  .q button {
    all: unset; cursor: pointer; box-sizing: border-box; width: 100%;
    display: flex; justify-content: space-between; align-items: center; gap: 16px;
    padding: 22px 0; font-size: 18px; font-weight: 700; color: var(--navy-800); line-height: 1.35;
  }
  .q button:focus-visible { outline: 3px solid var(--cyan-500); outline-offset: 3px; }
  .icon { flex-shrink: 0; width: 36px; height: 36px; border-radius: 50%; background: var(--blue-600); color: var(--white); display: flex; align-items: center; justify-content: center; font-size: 20px; }
  .a { padding: 0 52px 24px 0; display: flex; flex-direction: column; gap: 8px; }
  .a[hidden] { display: none; }
  .a p { font-size: 16px; line-height: 1.6; color: var(--ink-body); }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-faq]').forEach((faq) => {
    const buttons = [...faq.querySelectorAll<HTMLButtonElement>('button[aria-controls]')];
    buttons.forEach((b) =>
      b.addEventListener('click', () => {
        const opening = b.getAttribute('aria-expanded') !== 'true';
        buttons.forEach((x) => {
          const on = x === b && opening;
          x.setAttribute('aria-expanded', String(on));
          x.querySelector('.icon')!.textContent = on ? '−' : '+';
          (document.getElementById(x.getAttribute('aria-controls')!) as HTMLElement).hidden = !on;
        });
      }),
    );
  });
</script>
