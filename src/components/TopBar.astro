---
/** Faixa de destaque no topo de todas as páginas (evento com vendas abertas). */
import Star from './Star.astro';
import { destaque } from '../data/destaque';
---
{destaque.ativo && (
  <a href={destaque.url} target="_blank" rel="noopener" class="topbar" data-track="cta_inscricao_click" data-track-slug={destaque.slug} data-track-origem="faixa_topo">
    <span class="container inner">
      <span class="tag"><Star size="11" /> {destaque.selo}</span>
      <span class="txt"><strong>{destaque.nome} {destaque.ano}</strong><span class="det"> · {destaque.quando} · {destaque.onde.split(' · ').pop()}</span></span>
      <span class="go">{destaque.cta} →</span>
    </span>
  </a>
)}
<style>
  .topbar { display: block; background: var(--cyan-500); color: var(--navy-800); transition: background-color .2s; }
  .topbar:hover { background: var(--cyan-300); }
  .inner { display: flex; align-items: center; justify-content: center; gap: 8px 16px; flex-wrap: wrap; min-height: 44px; padding-block: 8px; font-size: 14px; line-height: 1.3; text-align: center; }
  .tag { display: inline-flex; align-items: center; gap: 6px; background: var(--navy-800); color: var(--white); font-size: 11.5px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; padding: 5px 10px; border-radius: 999px; }
  .txt strong { font-weight: 800; }
  .det { font-weight: 500; }
  .go { font-weight: 800; text-decoration: underline; text-underline-offset: 3px; }
  @media (max-width: 640px) { .det { display: none; } .tag { display: none; } }
</style>
