---
/**
 * Espaço de imagem. Com `src`, renderiza a foto otimizada; sem `src`
 * (foto ainda não enviada), mostra um bloco da marca com a estrela e,
 * no modo revisão, a descrição da foto esperada.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Star from './Star.astro';
import { SHOW_PENDING } from '../lib/pending';

interface Props {
  src?: ImageMetadata | null;
  alt?: string;
  label?: string;
  widths?: number[];
  sizes?: string;
  loading?: 'lazy' | 'eager';
  class?: string;
  style?: string;
}
const { src, alt = '', label, widths = [400, 800, 1200], sizes = '(min-width: 1320px) 440px, 100vw', loading = 'lazy', class: cls, style } = Astro.props;
---
<div class:list={['img-slot', cls]} style={style}>
  {src ? (
    <Image src={src} alt={alt} width={Math.min(Math.max(...widths), src.width)} widths={widths.filter((w) => w <= src.width)} sizes={sizes} loading={loading} format="webp" quality={78} />
  ) : (
    <>
      <Star class="slot-motif" size="100%" />
      {SHOW_PENDING && label && <span class="slot-label"><span class="pending">Foto pendente: {label}</span></span>}
    </>
  )}
</div>
