# URL pública do site (canonical, sitemap, Open Graph)
SITE_URL=https://academiadamagia.com.br

# Modo revisão: "true" mostra as etiquetas amarelas de conteúdo pendente
# ([A PREENCHER] / [CONFIRMAR]) e os rascunhos do blog. NUNCA usar em produção.
PUBLIC_SHOW_PENDING=false

# WhatsApp do atendimento: DDI + DDD + número (ex.: 5511999998888).
# Ativa o botão flutuante e todos os botões "Falar no WhatsApp".
PUBLIC_WHATSAPP_NUMERO=

# Links globais (deixe vazio enquanto estiverem pendentes)
PUBLIC_WHATSAPP_URL=
PUBLIC_ACADEMIA365_URL=
PUBLIC_INSTAGRAM_URL=
PUBLIC_YOUTUBE_URL=
PUBLIC_PODCAST_URL=
PUBLIC_PROTAGONISTAS_URL=

# Google Tag Manager (carregado só após consentimento de cookies)
PUBLIC_GTM_ID=
