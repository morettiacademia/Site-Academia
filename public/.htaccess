# Site Academia da Magia — configuração para hospedagem Apache (GoDaddy / cPanel)
AddDefaultCharset UTF-8
Options -MultiViews -Indexes
DirectorySlash Off
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # HTTPS sempre
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # www.academiadamagia.com.br -> academiadamagia.com.br
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # Arquivo interno da publicação automática
  RewriteRule ^\.ftp-deploy-sync-state\.json$ - [F,L]

  # /index.html e /index -> /
  RewriteRule ^index(\.html)?$ / [R=301,L]

  # /pagina.html -> /pagina (endereço limpo)
  RewriteCond %{THE_REQUEST} \s/+([^?\s]+?)\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L,NE]

  # /admin -> /admin/ (painel do blog)
  RewriteRule ^admin$ /admin/ [R=301,L]

  # /pagina/ -> /pagina quando existe pagina.html
  RewriteCond %{REQUEST_URI} ^/(.+)/$
  RewriteCond %{DOCUMENT_ROOT}/%1.html -f
  RewriteRule ^ /%1 [R=301,L]

  # /pagina -> serve pagina.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]

  # Pastas sem index.html (ex.: /sobre/ ou /blog/) -> página correspondente
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html !-f
  RewriteRule ^(.+?)/?$ /$1.html [L]
</IfModule>

# Cache: arquivos com hash no nome (CSS, JS, imagens e fontes gerados no build)
<IfModule mod_headers.c>
  <If "%{REQUEST_URI} =~ m#^/_astro/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <FilesMatch "\.(html|xml|txt|yml)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/plain application/xml text/yaml
</IfModule>

AddType text/yaml .yml
AddType image/avif .avif
AddType font/woff2 .woff2
